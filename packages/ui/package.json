{
  "name": "@hms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./security": {
      "types": "./dist/security/headers.d.ts",
      "default": "./dist/security/headers.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/tiktok-sans": "5.3.0",
    "@fontsource/tiro-bangla": "5.3.0",
    "@hms/i18n": "workspace:*",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "@hms/config-typescript": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
